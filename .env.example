# Copy this file to .env and add keys for the services you want to use.
OPENAI_API_KEY=

# Model used for transaction extraction, conversation, and research.
OPENAI_MODEL=gpt-5.6-terra

OPENAI_BASE_URL=https://api.openai.com/v1

# HTTP port. Hosting providers commonly set PORT automatically.
PORT=8765

# Enable authentication for any internet-accessible deployment.
APP_REQUIRE_AUTH=0
APP_USERNAME=
# Use at least 12 characters and keep this file private.
APP_PASSWORD=
# Generate a random secret with at least 32 characters.
APP_SESSION_SECRET=
APP_SESSION_HOURS=12
# auto adds Secure when the proxy reports HTTPS.
APP_SECURE_COOKIES=auto

# Linux/WSL: owner of ./data. Check with `id -u` and `id -g`.
LOCAL_UID=1000
LOCAL_GID=1000

TWELVE_DATA_API_KEY=
FMP_API_KEY=
FRED_API_KEY=
FINNHUB_API_KEY=
TIINGO_API_TOKEN=

# Analyst targets and recommendations change less often than quotes.
# The default persistent cache is 24 hours.
ANALYST_CONSENSUS_TTL_SECONDS=86400

# SEC requires an identifiable User-Agent with a real contact email.
# Example: PortfolioLedgerAgent/0.4 name@example.com
SEC_USER_AGENT=
