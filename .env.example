# Copia este archivo como .env y completa solamente tu clave de OpenAI.
OPENAI_API_KEY=

# Un unico GPT para interpretar movimientos, conversar y analizar.
OPENAI_MODEL=gpt-5.6-terra

OPENAI_BASE_URL=https://api.openai.com/v1

# Puerto HTTP. Los proveedores de hosting suelen definir PORT automáticamente.
PORT=8765

# Activar en cualquier despliegue accesible desde Internet.
APP_REQUIRE_AUTH=0
APP_USERNAME=
# Use al menos 12 caracteres y no comparta este archivo.
APP_PASSWORD=
# Genere un valor aleatorio de al menos 32 caracteres.
APP_SESSION_SECRET=
APP_SESSION_HOURS=12
# auto agrega Secure cuando el proxy informa HTTPS.
APP_SECURE_COOKIES=auto

# Linux/WSL: usuario propietario de ./data. Consultar con `id -u` e `id -g`.
LOCAL_UID=1000
LOCAL_GID=1000

TWELVE_DATA_API_KEY=
FMP_API_KEY=
FRED_API_KEY=
FINNHUB_API_KEY=
TIINGO_API_TOKEN=

# Analyst targets and recommendations change less often than quotes.
# The default persistent cache is 24 hours.
ANALYST_CONSENSUS_TTL_SECONDS=86400

# SEC exige un User-Agent identificable con un correo real.
# Ejemplo: PortfolioLedgerAgent/0.4 nombre@dominio.com
SEC_USER_AGENT=
