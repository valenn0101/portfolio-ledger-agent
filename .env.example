# Copia este archivo como .env y completa solamente tu clave de OpenAI.
OPENAI_API_KEY=

# Un unico GPT para interpretar movimientos, conversar y analizar.
OPENAI_MODEL=gpt-5.6-terra

OPENAI_BASE_URL=https://api.openai.com/v1

# Puerto HTTP. Los proveedores de hosting suelen definir PORT automáticamente.
PORT=8765

# Linux/WSL: usuario propietario de ./data. Consultar con `id -u` e `id -g`.
LOCAL_UID=1000
LOCAL_GID=1000

TWELVE_DATA_API_KEY=
FMP_API_KEY=
FRED_API_KEY=
FINNHUB_API_KEY=
TIINGO_API_TOKEN=

# SEC exige un User-Agent identificable con un correo real.
# Ejemplo: PortfolioLedgerAgent/0.4 nombre@dominio.com
SEC_USER_AGENT=
